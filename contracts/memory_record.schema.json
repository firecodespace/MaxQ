{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxq/contracts/memory_record.schema.json",
  "title": "memory_record - one experience-memory point (Phase 2, 6.4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "vector_spec",
    "vector",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "_note": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "vector_spec": {
      "type": "string",
      "minLength": 1
    },
    "vector": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "mission_id",
        "attempt_id",
        "profile",
        "rocket_id",
        "feasible",
        "cost",
        "plan",
        "failure_modes",
        "sim_version",
        "verifier_version",
        "created_utc"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "enum": [
            "crew_iss",
            "cargo_iss",
            "geo_comm",
            "meo_gps"
          ]
        },
        "rocket_id": {
          "type": "string",
          "minLength": 1
        },
        "feasible": {
          "type": "boolean"
        },
        "cost": {
          "type": "number"
        },
        "plan": {
          "type": "object"
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sim_version": {
          "type": "string",
          "minLength": 1
        },
        "verifier_version": {
          "type": "string",
          "minLength": 1
        },
        "created_utc": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
