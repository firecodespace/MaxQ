{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxq/contracts/session.schema.json",
  "title": "session.jsonl - ONE event (one line) of the stream/replay log (Phase 2, 6.3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "t_wall",
    "type"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "_note": {
      "type": "string"
    },
    "t_wall": {
      "type": "number",
      "minimum": 0
    },
    "type": {
      "enum": [
        "mission_started",
        "attempt_started",
        "memory_hit",
        "agent_step",
        "phase_changed",
        "telemetry",
        "constraint_update",
        "attempt_finished",
        "benchmark_update",
        "mission_finished"
      ]
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "plan",
        "tool_call",
        "tool_result",
        "memory_hit",
        "decision",
        "note"
      ]
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent_step"
          }
        }
      },
      "then": {
        "required": [
          "kind",
          "summary"
        ],
        "description": "An agent_step always says what kind of step it is and summarises it. attempt_id is OPTIONAL: a step may be about the mission rather than about one attempt. The agent tool layer (WP2-11) makes that unavoidable -- get_constraints and query_memory are called before any attempt exists, and a warm-start decision is taken between attempts. When attempt_id IS present, contracts/validate.py still requires it to name an attempt that has started and not finished."
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "attempt_started",
              "attempt_finished",
              "phase_changed",
              "telemetry",
              "constraint_update"
            ]
          }
        }
      },
      "then": {
        "required": [
          "attempt_id"
        ]
      }
    }
  ]
}
