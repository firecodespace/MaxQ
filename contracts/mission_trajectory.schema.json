{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxq/contracts/mission_trajectory.schema.json",
  "title": "<attempt>.traj.json - downsampled multi-phase trajectory (Phase 2, 6.2). Extends v1 trajectory with a phase per sample and relative-motion fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "attempt_id",
    "t0_unix",
    "t_s",
    "phase",
    "lat_deg",
    "lon_deg",
    "alt_m",
    "speed_mps",
    "mass_kg"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "_note": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "t0_unix": {
      "type": "integer"
    },
    "t_s": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      },
      "description": "strictly increasing; not necessarily 1 Hz"
    },
    "phase": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "ascent",
          "parking",
          "phasing",
          "approach",
          "dock",
          "transfer",
          "circularise"
        ],
        "description": "Mission phases. ascent/parking are common to every profile. phasing/approach/dock are the RENDEZVOUS path (crew_iss, cargo_iss). transfer/circularise are the ORBIT-RAISING path (geo_comm, meo_gps), where there is nothing to catch up with and nothing to dock to: the vehicle raises apogee and then circularises, combining the plane change into that burn. A single attempt follows one path or the other, never both."
      }
    },
    "lat_deg": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      }
    },
    "lon_deg": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      }
    },
    "alt_m": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "speed_mps": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "mass_kg": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "q_pa": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "accel_g": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "rel_pos_m": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "LVLH position relative to the target; null outside approach"
    },
    "rel_vel_mps": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t_s",
          "name"
        ],
        "properties": {
          "t_s": {
            "type": "number",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
