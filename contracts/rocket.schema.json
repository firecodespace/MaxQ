{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxq/contracts/rocket.schema.json",
  "title": "rocket.json - fictional rocket archetype (producer WP-05/07)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "profile", "payload_kg", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "_note": {"type": "string"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "profile": {"enum": ["crew_iss", "cargo_iss", "geo_comm", "meo_gps"]},
    "payload_kg": {"type": "number", "exclusiveMinimum": 0},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dry_kg", "prop_kg", "thrust_n", "isp_s", "cd", "area_m2"],
        "properties": {
          "dry_kg": {"type": "number", "exclusiveMinimum": 0},
          "prop_kg": {"type": "number", "exclusiveMinimum": 0},
          "thrust_n": {"type": "number", "exclusiveMinimum": 0},
          "isp_s": {"type": "number", "exclusiveMinimum": 0},
          "cd": {"type": "number", "minimum": 0},
          "area_m2": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
