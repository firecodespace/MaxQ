{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxq/contracts/manifest_instance.schema.json",
  "title": "manifest_instance.json - scheduling instance (producer WP-10)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "pads", "missions", "tasks", "conflicts"],
  "properties": {
    "schema_version": {"const": 1},
    "_note": {"type": "string"},
    "id": {"type": "string", "minLength": 1},
    "pads": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "missions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mission", "pad", "start_unix", "end_unix", "value"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "mission": {"type": "string"},
          "pad": {"type": "string"},
          "start_unix": {"type": "integer"},
          "end_unix": {"type": "integer"},
          "value": {"type": "number"},
          "window_id": {"type": "string", "description": "Optional link back to windows.json"}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "integer", "minimum": 0}
      }
    }
  }
}
